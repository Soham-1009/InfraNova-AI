# ==============================================================================
# InfraNova AI — Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Port to expose on host loopback 127.0.0.1 (default: 8000)
PORT=8000

# OpenMP CPU thread limit (recommended: 4 for high-core CPU / ARM64 Ampere A1 instances)
# OMP_NUM_THREADS=4

# Path to the active production model weights (default: outputs/best/pix2pix_landsat_best.pth)
INFRANOVA_CHECKPOINT=outputs/best/pix2pix_landsat_best.pth

# Inference execution device: "cpu", "cuda", or leave blank for automatic detection
INFRANOVA_DEVICE=

# Spatial tile size expected by the generator (default: 128)
INFRANOVA_IMAGE_SIZE=128

# Allowed CORS origins for the FastAPI REST endpoints (comma-separated, or * for all)
INFRANOVA_CORS_ORIGINS=*

# PyTorch wheel index URL for Docker build:
# CPU:  https://download.pytorch.org/whl/cpu
# CUDA: https://download.pytorch.org/whl/cu121
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# Frontend API base URL:
# Leave blank for same-origin relative URLs (/colorize, /health) in production.
# Set only if frontend and backend are hosted on different origins.
VITE_API_URL=
